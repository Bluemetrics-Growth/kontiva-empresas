---
// 03 - Os quatro problemas (PRD v3 secao 6). Grid de 4 cards, sem paragrafos
// longos. Consolida as cinco dores da versao anterior.
const cards = [
  { k: "Crédito", t: "Seu crédito passa a depender do fornecedor.", d: "Monitore quem gera crédito, quem não gera e onde existe risco.", ico: '<path d="M3 6h11v9H3z"/><path d="M14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>' },
  { k: "Compras", t: "Preço bruto deixa de ser custo real.", d: "Compare fornecedores pelo custo depois do crédito.", ico: '<path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6L5 3H2"/><circle cx="9" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/>' },
  { k: "Preço", t: "Margem precisa ser recalculada.", d: "Simule contratos e repasses antes que a margem desapareça.", ico: '<path d="M4 20V10M10 20V4M16 20v-7M4 20h16"/>' },
  { k: "Caixa", t: "O impacto tributário chega no capital de giro.", d: "Projete caixa com e sem split payment.", ico: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 14h4"/>' },
];
---
<section class="bg-alt" id="problemas" aria-labelledby="prob-h">
  <div class="shell">
    <div class="section-head reveal">
      <div class="eyebrow"><span class="dot-cyan"></span> O que muda na prática</div>
      <h2 id="prob-h">Quatro decisões que passam a ser fiscais.</h2>
    </div>
    <div class="prob-grid">
      {cards.map((c, i) => (
        <article class={`prob-card reveal delay-${i % 3}`}>
          <span class="prob-ico" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={c.ico} />
          </span>
          <div class="prob-kicker">{c.k}</div>
          <h3 class="prob-title">{c.t}</h3>
          <p class="prob-desc">{c.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>
