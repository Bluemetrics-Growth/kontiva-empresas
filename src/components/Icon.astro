---
// Icone SVG inline (decorativo por padrao). Paths em src/lib/icons.ts.
import { icons, type IconName } from "../lib/icons";

interface Props { name: IconName; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons[name]} />
