---
// 01 - Hero. Sem foto: a dor do credito aparece desenhada logo abaixo da
// promessa (CreditChain). Fundo navy com a grade e o brilho ciano do design
// system. H1 a esquerda, lead e CTAs a direita, alinhados na base.
import CreditChain from "./CreditChain.astro";
import { CTA_PRIMARIO as CTA, CTA_SECUNDARIO, CTA_ANCORA } from "../../content/site";
---
<section class="hero" id="topo" aria-labelledby="hero-h1">
  <div class="shell">
    <div class="hero-top">
      <div class="hero-head">
        <div class="eyebrow"><span class="dot-cyan"></span> IA fiscal-tributária para empresas</div>
        <h1 id="hero-h1">A Reforma Tributária vai bater no seu <span class="accent">caixa</span>.</h1>
      </div>
      <div class="hero-side">
        <p class="lead hero-sub">E começa pelo crédito que depende do seu fornecedor. A Kontiva simula o impacto com os dados da sua empresa antes de 2027.</p>
        <div class="hero-cta-row">
          <a href={CTA_ANCORA} class="btn btn-primary btn-lg" data-cta="hero">{CTA}</a>
          <a href="#produto" class="btn btn-ghost btn-lg" data-cta="hero-secondary">{CTA_SECUNDARIO}</a>
        </div>
        <p class="hero-cta-note">1 CNPJ, 1 cenário, sem custo. Para Lucro Presumido e Lucro Real enxuto.</p>
      </div>
    </div>
    <CreditChain />
  </div>
</section>
