---
// 01 - Hero (PRD revisao, secoes 4.1, 4.9 e 5.2). Risco operacional concreto +
// IA auditavel + CTA de diagnostico com o limite explicito. Foto de fundo com
// pessoas no terco direito e espaco negativo a esquerda para a copy.
// Art direction: recorte 4:5 no mobile. Card do agente em sobreposicao.
import { seloExemplo } from "../../content/facts";
import { CTA_PRIMARIO as CTA, CTA_SECUNDARIO, CTA_ANCORA, DIAG_LIMITE } from "../../content/site";

const agente = [
  "Lê XML, PDF, SPED e dados financeiros",
  "Cruza fornecedor, crédito, preço e caixa",
  "Explica a origem de cada número",
  "Registra aprovação humana antes de qualquer ação",
];
---
<section class="hero hero-photo" id="topo" aria-labelledby="hero-h1">
  <picture class="hero-photo-bg" aria-hidden="true">
    <!-- Mobile: recorte 4:5 focado nas pessoas -->
    <source
      media="(max-width: 860px)"
      type="image/avif"
      srcset="/images/hero-kontiva-empresas-m-640.avif 640w, /images/hero-kontiva-empresas-m-900.avif 900w"
      sizes="100vw"
    />
    <source
      media="(max-width: 860px)"
      type="image/webp"
      srcset="/images/hero-kontiva-empresas-m-640.webp 640w, /images/hero-kontiva-empresas-m-900.webp 900w"
      sizes="100vw"
    />
    <!-- Desktop: composicao completa 16:9 -->
    <source
      type="image/avif"
      srcset="/images/hero-kontiva-empresas-800.avif 800w, /images/hero-kontiva-empresas-1280.avif 1280w, /images/hero-kontiva-empresas-1672.avif 1672w"
      sizes="100vw"
    />
    <source
      type="image/webp"
      srcset="/images/hero-kontiva-empresas-800.webp 800w, /images/hero-kontiva-empresas-1280.webp 1280w, /images/hero-kontiva-empresas-1672.webp 1672w"
      sizes="100vw"
    />
    <img
      src="/images/hero-kontiva-empresas-1280.jpg"
      srcset="/images/hero-kontiva-empresas-800.jpg 800w, /images/hero-kontiva-empresas-1280.jpg 1280w, /images/hero-kontiva-empresas-1672.jpg 1672w"
      sizes="100vw"
      width="1672"
      height="941"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero-photo-overlay" aria-hidden="true"></div>
  <div class="hero-photo-grid" aria-hidden="true"></div>

  <div class="shell hero-photo-inner">
    <div class="hero-copy">
      <div class="eyebrow reveal"><span class="dot-cyan"></span> IA fiscal-tributária · Lucro Presumido e Lucro Real enxuto</div>

      <h1 id="hero-h1" class="reveal delay-1">
        A Reforma Tributária já entrou na operação. Agora o <span class="accent">risco</span> está no seu crédito, nos seus fornecedores, no preço e no caixa.
      </h1>

      <p class="lead hero-sub reveal delay-2">
        A Kontiva conecta os dados fiscais e financeiros da sua empresa, simula cenários da reforma e mostra onde crédito, margem e capital de giro podem ser pressionados antes da decisão chegar tarde demais.
      </p>

      <div class="hero-cta-row reveal delay-2">
        <a href={CTA_ANCORA} class="btn btn-primary btn-lg" data-cta="hero">{CTA}</a>
        <a href="#produto" class="btn btn-ghost btn-lg" data-cta="hero-secondary">{CTA_SECUNDARIO}</a>
      </div>
      <p class="hero-cta-note reveal delay-3">{DIAG_LIMITE} Sem custo e sem compromisso.</p>

      <div class="hero-seal reveal delay-3">
        <div>
          <span class="tick">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>
          </span> Integra com ERP, planilhas e documentos fiscais
        </div>
        <div>
          <span class="tick">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>
          </span> Decisão sempre com aprovação humana
        </div>
      </div>
    </div>

    <aside class="hero-proof hero-agent reveal delay-3" aria-labelledby="hero-agent-h">
      <span class="hero-proof-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/><rect x="7" y="7" width="10" height="10" rx="2"/><path d="M10 12h4"/></svg>
      </span>
      <div class="hero-proof-main">
        <span class="hero-proof-label">Como a IA trabalha</span>
        <span id="hero-agent-h" class="hero-agent-title">Agente de IA, decisão humana.</span>
        <span class="hero-proof-sub">Lê documentos, cruza dados, simula cenários e aponta riscos. Seu time aprova, revisa e decide com memória de cálculo.</span>
      </div>
      <ul class="hero-agent-list">
        {agente.map((a) => <li>{a}</li>)}
      </ul>
      <div class="hero-agent-example">
        <b>R$ 214.700</b> em crédito potencial sob revisão
      </div>
      <span class="hero-proof-tag">{seloExemplo}</span>
    </aside>
  </div>
</section>
