---
// 01 - Hero v3 (PRD v3 secao 4). Promessa + prova + CTA. Foto de fundo com
// pessoas no terco direito e espaco negativo a esquerda para a copy.
// Art direction: recorte 4:5 no mobile. Card de produto em sobreposicao.
import { seloExemplo } from "../../content/facts";
import { CTA_PRIMARIO as CTA, CTA_ANCORA } from "../../content/site";
---
<section class="hero hero-photo" id="topo" aria-labelledby="hero-h1">
  <picture class="hero-photo-bg" aria-hidden="true">
    <!-- Mobile: recorte 4:5 focado nas pessoas -->
    <source
      media="(max-width: 860px)"
      type="image/avif"
      srcset="/images/hero-kontiva-empresas-m-640.avif 640w, /images/hero-kontiva-empresas-m-900.avif 900w"
      sizes="100vw"
    />
    <source
      media="(max-width: 860px)"
      type="image/webp"
      srcset="/images/hero-kontiva-empresas-m-640.webp 640w, /images/hero-kontiva-empresas-m-900.webp 900w"
      sizes="100vw"
    />
    <!-- Desktop: composicao completa 16:9 -->
    <source
      type="image/avif"
      srcset="/images/hero-kontiva-empresas-800.avif 800w, /images/hero-kontiva-empresas-1280.avif 1280w, /images/hero-kontiva-empresas-1672.avif 1672w"
      sizes="100vw"
    />
    <source
      type="image/webp"
      srcset="/images/hero-kontiva-empresas-800.webp 800w, /images/hero-kontiva-empresas-1280.webp 1280w, /images/hero-kontiva-empresas-1672.webp 1672w"
      sizes="100vw"
    />
    <img
      src="/images/hero-kontiva-empresas-1280.jpg"
      srcset="/images/hero-kontiva-empresas-800.jpg 800w, /images/hero-kontiva-empresas-1280.jpg 1280w, /images/hero-kontiva-empresas-1672.jpg 1672w"
      sizes="100vw"
      width="1672"
      height="941"
      alt=""
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="hero-photo-overlay" aria-hidden="true"></div>
  <div class="hero-photo-grid" aria-hidden="true"></div>

  <div class="shell hero-photo-inner">
    <div class="hero-copy">
      <div class="eyebrow reveal"><span class="dot-cyan"></span> Reforma tributária · operação 2027</div>

      <h1 id="hero-h1" class="reveal delay-1">
        A reforma muda o imposto. O Kontiva muda <span class="accent">como sua empresa opera isso</span>.
      </h1>

      <p class="lead hero-sub reveal delay-2">
        O Kontiva conecta os dados da sua empresa, simula o impacto da reforma e transforma crédito, fornecedores, preço e caixa em uma rotina operacional acompanhada pelo seu time.
      </p>

      <div class="hero-cta-row reveal delay-2">
        <a href={CTA_ANCORA} class="btn btn-primary btn-lg" data-cta="hero">{CTA}</a>
        <a href="#produto" class="btn btn-ghost btn-lg" data-cta="hero-secondary">Entender como funciona</a>
      </div>
      <p class="hero-cta-note reveal delay-3">Demo com dados da sua empresa · sem custo</p>

      <div class="hero-seal reveal delay-3">
        <div>
          <span class="tick">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>
          </span> SAP · TOTVS · Oracle · Senior · Planilhas
        </div>
        <div>
          <span class="tick">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>
          </span> Aprovação humana antes de qualquer ação
        </div>
      </div>
    </div>

    <aside class="hero-proof reveal delay-3" aria-label="Exemplo ilustrativo de crédito em risco">
      <span class="hero-proof-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/></svg>
      </span>
      <div class="hero-proof-main">
        <span class="hero-proof-label">Crédito de IBS/CBS em risco</span>
        <span class="hero-proof-value">R$ <b>214.700</b></span>
        <span class="hero-proof-sub">em 7 fornecedores sem recolhimento confirmado</span>
      </div>
      <span class="hero-proof-tag">{seloExemplo}</span>
    </aside>
  </div>
</section>
