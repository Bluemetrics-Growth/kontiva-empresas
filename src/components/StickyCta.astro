---
// Barra fixa mobile. Aparece depois do hero e some quando o agendamento
// entra na tela. A logica de exibicao esta no script do Base.astro.
import { CTA_PRIMARIO, CTA_ANCORA } from "../../content/site";
---
<div id="sticky-cta">
  <a href={CTA_ANCORA} class="btn btn-primary" data-cta="sticky">{CTA_PRIMARIO}</a>
  <span class="sticky-note">Gratuita, com seus dados</span>
</div>
