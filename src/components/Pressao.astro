---
// 04 - Bloco de pressao: onde o mercado esta (PRD 6.3). Tres numeros em
// destaque, cada um com a fonte visivel (content/facts.ts).
import { facts } from "../../content/facts";
const nums = [facts.maturidadeAlta, facts.naoMapearam, facts.aliquotaEstimadaCombinada];
---
<section class="bg-dark grain" aria-labelledby="pressao-h">
  <div class="shell">
    <div class="section-head reveal">
      <div class="eyebrow"><span class="dot-cyan"></span> Onde o mercado está</div>
      <h2 id="pressao-h" style="color:var(--branco);">A boa notícia é que quase ninguém está pronto. A má é que isso não protege a sua margem.</h2>
    </div>

    <div class="pressao-nums reveal delay-1">
      {nums.map((n) => (
        <article class="pressao-card">
          <div class="pressao-num">{n.value}</div>
          <p class="pressao-label">{n.label}</p>
          <small class="pressao-fonte">
            {n.source}{n.caveat ? `. ${n.caveat}` : ""}
          </small>
        </article>
      ))}
    </div>

    <p class="pressao-close reveal">Estar atrasado junto com o mercado não devolve crédito perdido nem margem repassada errado. Em janeiro, cada empresa fecha o próprio mês sozinha.</p>
  </div>
</section>
