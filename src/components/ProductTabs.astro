---
// 04 - Como opera. Quatro abas (role="tablist") com roving tabindex:
// setas esquerda/direita, Home e End. Cada painel traz o par risco / como a
// Kontiva ajuda, o exemplo ilustrativo, um link contextual e a "planilha".
import OperationPanel from "./OperationPanel.astro";
import { abas } from "../../content/secoes";
---
<section class="bg-page" id="produto" aria-labelledby="prod-h">
  <div class="shell">
    <div class="section-head">
      <div class="eyebrow"><span class="dot-cyan"></span> Onde a Reforma bate</div>
      <h2 id="prod-h">Imposto agora passa por compras, preço e <span class="serif-accent">caixa</span>.</h2>
      <p class="lead">A Reforma muda a operação, não só a alíquota. A Kontiva transforma XML, SPED e planilha em alertas e simulações, e mostra onde agir primeiro.</p>
    </div>

    <div class="ptabs">
      <div class="ptab-btns" role="tablist" aria-label="Decisões que mudam com a reforma">
        {abas.map((t, i) => (
          <button type="button" class="ptab-btn" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`}
            aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? "0" : "-1"}
            data-tab={t.id} data-tab-label={t.label}>{t.label}</button>
        ))}
      </div>
      {abas.map((t, i) => <OperationPanel aba={t} active={i === 0} />)}
    </div>
  </div>
</section>

<script>
  const root = document.getElementById("produto");
  if (root) {
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>(".ptab-btn"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".ptab-panel"));
    const viewed = new Set();
    const fireView = (label: string | null) => {
      if (viewed.has(label)) return;
      viewed.add(label);
      if (typeof (window as any).__ktrack === "function") (window as any).__ktrack("product_tab_view", { tab: label });
    };
    const activate = (btn: HTMLButtonElement, focus = false) => {
      const id = btn.getAttribute("data-tab");
      btns.forEach((b) => {
        const on = b === btn;
        b.setAttribute("aria-selected", on ? "true" : "false");
        b.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => { p.hidden = p.id !== `panel-${id}`; });
      if (focus) { btn.focus(); btn.scrollIntoView({ block: "nearest", inline: "nearest" }); }
      fireView(btn.getAttribute("data-tab-label"));
    };
    btns.forEach((b, i) => {
      b.addEventListener("click", () => activate(b));
      b.addEventListener("keydown", (e) => {
        const last = btns.length - 1;
        let next = -1;
        if (e.key === "ArrowRight") next = i === last ? 0 : i + 1;
        else if (e.key === "ArrowLeft") next = i === 0 ? last : i - 1;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = last;
        if (next < 0) return;
        e.preventDefault();
        activate(btns[next], true);
      });
    });
    // primeira aba: dispara product_tab_view quando a secao entra na tela
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((e) => {
        if (e[0].isIntersecting) { const f = btns[0]; fireView(f && f.getAttribute("data-tab-label")); io.disconnect(); }
      }, { threshold: 0.3 });
      io.observe(root);
    }
  }
</script>
