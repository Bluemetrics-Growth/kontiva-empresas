---
// 04 - Produto em acao (PRD v3 secao 7). Tabs no desktop, uma tela por vez.
// Cada aba: screenshot (mini tela realista), headline curta, 1 frase, 1 metrica
// e 1 CTA. Aparece cedo no scroll (antes de 40%).
import { CTA_CONTEXTUAL, CTA_ANCORA } from "../../content/site";
import { seloExemplo } from "../../content/facts";
const tabs = [
  { id: "sim", label: "Simulação tributária" },
  { id: "forn", label: "Fornecedores e créditos" },
  { id: "rep", label: "Repricing" },
  { id: "caixa", label: "Fluxo de caixa" },
];
---
<section class="bg-page" id="produto" aria-labelledby="prod-h">
  <div class="shell">
    <div class="section-head reveal">
      <div class="eyebrow"><span class="dot-cyan"></span> Produto em ação</div>
      <h2 id="prod-h">Uma operação, quatro respostas.</h2>
      <p class="urg3-copy">O Kontiva cruza dados fiscais, financeiros e comerciais para mostrar o que precisa de decisão agora.</p>
    </div>

    <div class="ptabs reveal delay-1">
      <div class="ptab-btns" role="tablist" aria-label="Módulos do produto">
        {tabs.map((t, i) => (
          <button class="ptab-btn" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? "true" : "false"} data-tab={t.id} data-tab-label={t.label}>{t.label}</button>
        ))}
      </div>

      <div class="ptab-panels">
        <!-- Simulação tributária -->
        <div class="ptab-panel active" id="panel-sim" role="tabpanel" aria-labelledby="tab-sim">
          <div class="pt-copy">
            <h3>Onde está o maior impacto</h3>
            <p>Veja quais CNPJs e unidades concentram maior impacto e qual ação merece prioridade.</p>
            <div class="pt-metric">22 unidades analisadas · 8 com impacto alto</div>
            <a href={CTA_ANCORA} class="btn btn-primary" data-cta="product">{CTA_CONTEXTUAL}</a>
          </div>
          <div class="pt-visual">
            <div class="mini" aria-hidden="true">
              <div class="mini-head">Simulação por unidade <span class="mini-live">Ranqueado por impacto</span></div>
              <div class="mini-body">
                <div class="mini-row"><b>Meridiano Consultoria</b><span>Presumido</span><span class="mini-badge risk">Impacto alto</span></div>
                <div class="mini-row"><b>Meridiano Tech</b><span>Presumido</span><span class="mini-badge risk">Impacto alto</span></div>
                <div class="mini-row"><b>Meridiano Indústria</b><span>Lucro Real</span><span class="mini-badge neutral">Impacto médio</span></div>
                <div class="mini-row"><b>Meridiano Serviços</b><span>Simples</span><span class="mini-badge ok">Impacto baixo</span></div>
              </div>
            </div>
            <small class="selo">{seloExemplo}</small>
          </div>
        </div>

        <!-- Fornecedores e créditos -->
        <div class="ptab-panel" id="panel-forn" role="tabpanel" aria-labelledby="tab-forn">
          <div class="pt-copy">
            <h3>Crédito que depende de quem vende</h3>
            <p>Acompanhe fornecedor a fornecedor quem gera crédito de IBS e CBS, quem não gera e onde existe risco.</p>
            <div class="pt-metric">R$ 214.700 em crédito em risco · 7 fornecedores</div>
            <a href={CTA_ANCORA} class="btn btn-primary" data-cta="product">{CTA_CONTEXTUAL}</a>
          </div>
          <div class="pt-visual">
            <div class="mini" aria-hidden="true">
              <div class="mini-head">Fornecedores <span class="mini-live">Risco de crédito</span></div>
              <div class="mini-body">
                <div class="mini-row"><b>Aurora Insumos</b><span>gera crédito</span><span class="mini-badge ok">Recolhe</span></div>
                <div class="mini-row"><b>Nordeste Log</b><span>crédito parcial</span><span class="mini-badge neutral">Simples</span></div>
                <div class="mini-row"><b>Vertex Peças</b><span>sem confirmação</span><span class="mini-badge risk">Risco</span></div>
                <div class="mini-row"><b>Meta Serviços</b><span>sem confirmação</span><span class="mini-badge risk">Risco</span></div>
              </div>
            </div>
            <small class="selo">{seloExemplo}</small>
          </div>
        </div>

        <!-- Repricing -->
        <div class="ptab-panel" id="panel-rep" role="tabpanel" aria-labelledby="tab-rep">
          <div class="pt-copy">
            <h3>Margem recalculada, com aprovação</h3>
            <p>Cruza cada contrato com o custo tributário novo e propõe o preço que preserva a margem, com memória de cálculo.</p>
            <div class="pt-metric">Reajuste aplicado só após aprovação do time</div>
            <a href={CTA_ANCORA} class="btn btn-primary" data-cta="product">{CTA_CONTEXTUAL}</a>
          </div>
          <div class="pt-visual">
            <div class="mini" aria-hidden="true">
              <div class="mini-head">Repricing de contratos <span class="mini-live">Memória de cálculo</span></div>
              <div class="mini-body">
                <div class="mini-row"><b>Contrato 24 meses</b><span>reajuste por IPCA</span><span class="mini-badge risk">Margem em queda</span></div>
                <div class="mini-row"><b>Custo tributário novo</b><span>+ IBS/CBS por fora</span><span class="mini-badge neutral">Recalculado</span></div>
                <div class="mini-row"><b>Preço que preserva a margem</b><span>revisão tributária</span><span class="mini-badge ok">Proposto</span></div>
              </div>
              <div class="mini-toggle"><span class="sw"></span> Aplicar só após aprovação do seu time</div>
            </div>
            <small class="selo">{seloExemplo}</small>
          </div>
        </div>

        <!-- Fluxo de caixa -->
        <div class="ptab-panel" id="panel-caixa" role="tabpanel" aria-labelledby="tab-caixa">
          <div class="pt-copy">
            <h3>Caixa com e sem split payment</h3>
            <p>Projeta o caixa mês a mês nos dois cenários, por unidade, com relatório pronto para a diretoria.</p>
            <div class="pt-metric">Comparativo guia tradicional × split payment</div>
            <a href={CTA_ANCORA} class="btn btn-primary" data-cta="product">{CTA_CONTEXTUAL}</a>
          </div>
          <div class="pt-visual">
            <div class="mini" aria-hidden="true">
              <div class="mini-head">Fluxo de caixa <span class="mini-live">Projeção mês a mês</span></div>
              <div class="mini-body">
                <div class="mini-row"><b>Guia tradicional</b><span>crédito volta em até 60 dias</span><span class="mini-badge risk">Capital preso</span></div>
                <div class="mini-row"><b>Split payment</b><span>recebe já líquido</span><span class="mini-badge risk">Sem float</span></div>
                <div class="mini-row"><b>Capital de giro</b><span>sobe em 2027</span><span class="mini-badge neutral">Projetado</span></div>
              </div>
              <div class="mini-toggle"><span class="sw"></span> Comparar: guia tradicional × split payment</div>
            </div>
            <small class="selo">{seloExemplo}</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById("produto");
  if (root) {
    const btns = Array.from(root.querySelectorAll(".ptab-btn"));
    const panels = Array.from(root.querySelectorAll(".ptab-panel"));
    const viewed = new Set();
    const fireView = (label) => {
      if (viewed.has(label)) return;
      viewed.add(label);
      if (typeof (window as any).__ktrack === "function") (window as any).__ktrack("product_tab_view", { tab: label });
    };
    const activate = (id, label) => {
      btns.forEach((b) => b.setAttribute("aria-selected", b.getAttribute("data-tab") === id ? "true" : "false"));
      panels.forEach((p) => p.classList.toggle("active", p.id === `panel-${id}`));
      fireView(label);
    };
    btns.forEach((b) => b.addEventListener("click", () => activate(b.getAttribute("data-tab"), b.getAttribute("data-tab-label"))));
    // primeira aba: dispara product_tab_view quando a secao entra na tela
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((e) => {
        if (e[0].isIntersecting) { const f = btns[0]; fireView(f && f.getAttribute("data-tab-label")); io.disconnect(); }
      }, { threshold: 0.3 });
      io.observe(root);
    }
  }
</script>
