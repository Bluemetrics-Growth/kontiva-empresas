---
// 08b - Planos (PRD revisao, secao 4.8, opcao A). Faixas por faturamento e
// franquia de uso. O simulador multi-cenario completo e a operacao mensal
// ficam no plano pago; o ponto de entrada continua sendo o diagnostico.
import { CTA_ANCORA } from "../../content/site";

const planos = [
  {
    nome: "Essencial",
    para: "1 CNPJ ou operação simples",
    inclui: ["Diagnóstico", "Monitoramento básico", "Simulações limitadas"],
    valor: "A partir de R$ 990/mês",
  },
  {
    nome: "Operação",
    para: "Empresas com múltiplos fornecedores e necessidade de acompanhamento",
    inclui: ["Simulador multi-cenário completo", "Fornecedores, créditos e caixa", "Acompanhamento mensal"],
    valor: "Sob consulta, por faixa",
    hl: true,
  },
  {
    nome: "Grupo",
    para: "Múltiplos CNPJs ou unidades",
    inclui: ["Consolidação por CNPJ", "Mais usuários", "Franquias ampliadas"],
    valor: "Até R$ 4.990/mês",
  },
];
---
<section class="bg-page" id="planos" aria-labelledby="plan-h">
  <div class="shell">
    <div class="section-head reveal">
      <div class="eyebrow"><span class="dot-cyan"></span> Depois do diagnóstico</div>
      <h2 id="plan-h">Planos para empresas que precisam operar a reforma com <span class="serif-accent">rotina</span>.</h2>
      <p class="urg3-copy">O diagnóstico gratuito mostra uma visão resumida. O plano completo libera simulações multi-cenário, acompanhamento mensal, fornecedores, usuários e rotinas por faixa de faturamento.</p>
    </div>

    <div class="plan-grid">
      {planos.map((p, i) => (
        <article class={`plan-card reveal delay-${i % 3}${p.hl ? " plan-hl" : ""}`}>
          <h3>{p.nome}</h3>
          <p class="plan-para">{p.para}</p>
          <ul>
            {p.inclui.map((x) => <li>{x}</li>)}
          </ul>
          <div class="plan-valor">{p.valor}</div>
        </article>
      ))}
    </div>

    <p class="plan-note reveal">Os planos variam por faixa de faturamento e franquia de uso. Excedentes viram sugestão de upgrade, nunca cobrança automática.</p>
    <div class="urg3-cta reveal">
      <a href={CTA_ANCORA} class="btn btn-dark" data-cta="planos">Começar pelo diagnóstico gratuito</a>
    </div>
  </div>
</section>
