---
// 02 - Reforma 2027. Esquerda: titulo, lead e contagem ate 01/01/2027 00:00
// (BRT). Direita: linha do tempo vertical e CTA. No HTML estatico os numeros
// saem como "--" (sem depender da hora do build); o script preenche e
// atualiza a cada segundo, nunca abaixo de zero.
import { facts } from "../../content/facts";
import { marcos } from "../../content/secoes";
import { CTA_PRIMARIO, CTA_ANCORA, DEMO_LIMITE } from "../../content/site";

const TARGET = "2027-01-01T00:00:00-03:00";
const unidades = [
  { k: "d", l: "dias" },
  { k: "h", l: "horas" },
  { k: "m", l: "minutos" },
  { k: "s", l: "segundos" },
];
---
<section class="bg-page" id="reforma-2027" aria-labelledby="cd-h">
  <div class="shell cd-grid">
    <div class="cd-copy">
      <div class="eyebrow"><span class="dot-cyan"></span> Reforma 2027</div>
      <h2 id="cd-h">1º de janeiro de 2027. A contagem <span class="serif-accent">já começou</span>.</h2>
      <p class="cd-text">A CBS entra em regime pleno e PIS e Cofins deixam de existir. A partir daí, o seu crédito depende do recolhimento de quem vende para você. Quem mapeia agora chega em 2027 decidindo com número. Quem espera descobre no caixa.</p>

      <div class="cd-clock" id="cd-2027" data-target={TARGET} role="timer" aria-live="off" aria-label="Contagem regressiva até 1º de janeiro de 2027">
        {unidades.map((u) => (
          <div class="cd-unit">
            <span class="cd-num" data-unit={u.k}>--</span>
            <span class="cd-lbl">{u.l}</span>
          </div>
        ))}
      </div>
      <p class="cd-target">até <b>{facts.cbsPlena.value}</b>. {facts.cbsPlena.label}.</p>
      <small class="cd-src">Fonte: {facts.cbsPlena.source}</small>
    </div>

    <div class="cd-side">
      <ol class="tl">
        {marcos.map((m) => (
          <li class={`tl-m${m.now ? " is-now" : ""}`}>
            <span class="tl-when">{m.when}{m.now && <em>agora</em>}</span>
            <p>{m.what}</p>
          </li>
        ))}
      </ol>
      <div class="cd-cta">
        <a href={CTA_ANCORA} class="btn btn-dark btn-lg" data-cta="countdown">{CTA_PRIMARIO}</a>
        <p class="cta-limit">{DEMO_LIMITE}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const el = document.getElementById("cd-2027");
  if (el) {
    const target = new Date(el.getAttribute("data-target") || "").getTime();
    const nums: Record<string, HTMLElement | null> = {
      d: el.querySelector('[data-unit="d"]'),
      h: el.querySelector('[data-unit="h"]'),
      m: el.querySelector('[data-unit="m"]'),
      s: el.querySelector('[data-unit="s"]'),
    };
    const pad = (n: number) => String(n).padStart(2, "0");
    let timer = 0;
    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      const total = Math.floor(diff / 1000);
      const vals: Record<string, string> = {
        d: String(Math.floor(total / 86400)),
        h: pad(Math.floor((total % 86400) / 3600)),
        m: pad(Math.floor((total % 3600) / 60)),
        s: pad(total % 60),
      };
      for (const k in nums) {
        const n = nums[k];
        if (n && n.textContent !== vals[k]) n.textContent = vals[k];
      }
      if (diff === 0 && timer) window.clearInterval(timer);
    };
    if (!Number.isNaN(target)) {
      tick();
      timer = window.setInterval(tick, 1000);
    }
  }
</script>
