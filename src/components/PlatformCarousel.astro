---
// 05 - Plataforma. Carrossel da interface: a esquerda, a lista de slides
// (titulo + descricao, navega e mostra o progresso do autoplay); a direita, a
// interface num frame de navegador. No mobile a lista some, cada slide traz
// seu titulo acima do frame e ha swipe, dots, anterior e proximo.
// Autoplay de 6 s: pausa em hover, foco, aba oculta, fora da tela e no botao
// de pausa; desligado com prefers-reduced-motion. Imagens so para visualizar
// (sem link, sem zoom, draggable="false").
import Icon from "./Icon.astro";
import { slides } from "../../content/secoes";
import { seloExemplo } from "../../content/facts";

const total = slides.length;
---
<section class="bg-alt" id="plataforma" aria-labelledby="pl-h">
  <div class="shell">
    <div class="section-head">
      <div class="eyebrow"><span class="dot-cyan"></span> Plataforma Kontiva</div>
      <h2 id="pl-h">É aqui que o seu time vai <span class="serif-accent">decidir</span>.</h2>
      <p class="lead">A interface da plataforma, com dados de demonstração. Na demo, você vê o mesmo fluxo com os dados da sua empresa.</p>
    </div>

    <div class="pl" data-carousel role="region" aria-roledescription="carousel" aria-label="Interface da plataforma Kontiva">
      <ol class="pl-list">
        {slides.map((s, i) => (
          <li>
            <button type="button" class={`pl-item${i === 0 ? " is-active" : ""}`} data-go={i} aria-controls={`pl-slide-${s.id}`} aria-current={i === 0 ? "true" : undefined}>
              <span class="pl-item-t">{s.titulo}</span>
              <span class="pl-item-d">{s.descricao}</span>
              <span class="pl-bar" aria-hidden="true"><span></span></span>
            </button>
          </li>
        ))}
      </ol>

      <div class="pl-stage">
        <div class="pl-viewport">
          <div class="pl-track" aria-live="polite">
            {slides.map((s, i) => (
              <div class="pl-slide" id={`pl-slide-${s.id}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} de ${total}`} aria-hidden={i === 0 ? undefined : "true"} inert={i !== 0}>
                <p class="pl-cap"><b>{s.titulo}</b> {s.descricao}</p>
                <div class="pl-frame">
                  <div class="scr-bar" aria-hidden="true">
                    <span class="scr-dots"><i></i><i></i><i></i></span>
                    <span class="scr-url">{s.url}</span>
                  </div>
                  <div class="pl-canvas">
                    {s.tipo === "imagem" && (
                      <picture>
                        <source srcset={`/images/telas/${s.id}.webp`} type="image/webp" />
                        <img src={`/images/telas/${s.id}.jpg`} width={s.w} height={s.h} alt={s.alt} loading={i === 0 ? "eager" : "lazy"} decoding="async" draggable="false" />
                      </picture>
                    )}
                    {s.tipo === "cenarios" && (
                      <div class="pl-mock" role="img" aria-label={s.alt}>
                        <div class="pl-mock-head"><b>Comparar cenários</b><span>Carga sobre a receita</span></div>
                        <div class="pl-cmp">
                          <span></span>
                          {s.anos.map((a) => <span class="pl-cmp-y">{a}</span>)}
                          {s.linhas.map((l) => (
                            <>
                              <span class={`pl-cmp-k${l.total ? " is-total" : ""}`}>{l.k}</span>
                              {l.v.map((v) => <span class={`pl-cmp-v${l.total ? " is-total" : ""}`}>{v}</span>)}
                            </>
                          ))}
                        </div>
                        <div class="pl-mock-foot">{seloExemplo}</div>
                      </div>
                    )}
                    {s.tipo === "acoes" && (
                      <div class="pl-mock" role="img" aria-label={s.alt}>
                        <div class="pl-mock-head"><b>Ações priorizadas</b><span>Ordem de impacto</span></div>
                        <ul class="pl-acts">
                          {s.acoes.map((a) => (
                            <li>
                              <span class={`pl-prio is-${a.prioridade === "Alta" ? "alta" : "media"}`}>{a.prioridade}</span>
                              <span class="pl-act-t"><b>{a.titulo}</b><small>{a.origem}</small></span>
                              <span class="pl-act-s">Aguardando aprovação</span>
                            </li>
                          ))}
                        </ul>
                        <div class="pl-mock-foot">{seloExemplo}</div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="pl-ctrl">
          <button type="button" class="pl-btn" data-prev aria-label="Slide anterior"><Icon name="chevronLeft" size={18} /></button>
          <div class="pl-dots">
            {slides.map((s, i) => (
              <button type="button" class={`pl-dot${i === 0 ? " is-active" : ""}`} data-go={i} aria-label={`Ir para o slide ${i + 1}: ${s.titulo}`} aria-current={i === 0 ? "true" : undefined}></button>
            ))}
          </div>
          <button type="button" class="pl-btn" data-next aria-label="Próximo slide"><Icon name="chevronRight" size={18} /></button>
          <button type="button" class="pl-btn pl-pause" data-pause aria-label="Pausar apresentação">
            <span class="i-pause"><Icon name="pause" size={16} /></span>
            <span class="i-play"><Icon name="play" size={16} /></span>
          </button>
        </div>
      </div>
    </div>
    <small class="scr-note">Interface da plataforma Kontiva com dados de demonstração. Nomes de fornecedores ocultados.</small>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-carousel]");
  if (root) {
    const DELAY = 6000;
    const track = root.querySelector<HTMLElement>(".pl-track")!;
    const viewport = root.querySelector<HTMLElement>(".pl-viewport")!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>(".pl-slide"));
    const items = Array.from(root.querySelectorAll<HTMLButtonElement>(".pl-item"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>(".pl-dot"));
    const pauseBtn = root.querySelector<HTMLButtonElement>("[data-pause]")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const n = slides.length;
    let index = 0;
    let userPaused = reduce;
    let hover = false, focusIn = false, inView = false;
    let timer = 0, startedAt = 0, remaining = DELAY;

    const running = () => !userPaused && !hover && !focusIn && inView && !document.hidden;

    const restartBar = () => {
      const bar = items[index]?.querySelector<HTMLElement>(".pl-bar span");
      if (!bar) return;
      bar.style.animation = "none";
      void bar.offsetWidth; // reinicia a animacao do progresso
      bar.style.animation = "";
    };

    const stop = () => {
      if (timer) { window.clearTimeout(timer); timer = 0; remaining -= Date.now() - startedAt; }
    };
    const start = () => {
      if (timer || !running()) return;
      startedAt = Date.now();
      timer = window.setTimeout(() => { timer = 0; go(index + 1); }, Math.max(0, remaining));
    };
    const sync = () => {
      const on = running();
      root.classList.toggle("is-paused", !on);
      track.setAttribute("aria-live", on ? "off" : "polite");
      if (on) start(); else stop();
    };

    function go(i: number) {
      index = (i + n) % n;
      track.style.transform = `translateX(${-index * 100}%)`;
      slides.forEach((s, k) => {
        const on = k === index;
        if (on) { s.removeAttribute("aria-hidden"); s.removeAttribute("inert"); }
        else { s.setAttribute("aria-hidden", "true"); s.setAttribute("inert", ""); }
      });
      [items, dots].forEach((list) => list.forEach((b, k) => {
        b.classList.toggle("is-active", k === index);
        if (k === index) b.setAttribute("aria-current", "true"); else b.removeAttribute("aria-current");
      }));
      if (timer) { window.clearTimeout(timer); timer = 0; }
      remaining = DELAY;
      restartBar();
      sync();
    }

    root.querySelectorAll<HTMLButtonElement>("[data-go]").forEach((b) => b.addEventListener("click", () => go(Number(b.dataset.go))));
    root.querySelector("[data-prev]")!.addEventListener("click", () => go(index - 1));
    root.querySelector("[data-next]")!.addEventListener("click", () => go(index + 1));
    pauseBtn.addEventListener("click", () => {
      userPaused = !userPaused;
      root.classList.toggle("is-stopped", userPaused);
      pauseBtn.setAttribute("aria-label", userPaused ? "Retomar apresentação" : "Pausar apresentação");
      sync();
    });

    // setas do teclado com o foco dentro do carrossel
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); go(index + 1); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); go(index - 1); }
    });

    root.addEventListener("mouseenter", () => { hover = true; sync(); });
    root.addEventListener("mouseleave", () => { hover = false; sync(); });
    root.addEventListener("focusin", () => { focusIn = true; sync(); });
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget as Node)) { focusIn = false; sync(); }
    });
    document.addEventListener("visibilitychange", sync);
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((en) => { inView = en[0].isIntersecting; sync(); }, { threshold: 0.35 }).observe(root);
    } else { inView = true; }

    // swipe horizontal (a rolagem vertical continua livre: touch-action pan-y)
    let x0 = 0, y0 = 0, tracking = false;
    viewport.addEventListener("pointerdown", (e) => { tracking = true; x0 = e.clientX; y0 = e.clientY; });
    viewport.addEventListener("pointerup", (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(index + (dx < 0 ? 1 : -1));
    });
    viewport.addEventListener("pointercancel", () => { tracking = false; });

    if (reduce) root.classList.add("is-stopped", "is-reduced");
    sync();
  }
</script>
