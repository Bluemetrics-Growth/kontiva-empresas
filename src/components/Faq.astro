---
// 10 - FAQ. <details> nativo; o "+" gira para "×" ao abrir.
import { faqs } from "../../content/secoes";
---
<section class="bg-page" id="faq" aria-labelledby="faq-h">
  <div class="shell faq-grid">
    <div class="section-head">
      <div class="eyebrow"><span class="dot-cyan"></span> Perguntas frequentes</div>
      <h2 id="faq-h">Ainda tem dúvida? A gente responde.</h2>
    </div>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q} <span class="faq-x" aria-hidden="true"></span></summary>
          <div class="faq-a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
