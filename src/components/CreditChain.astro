---
// Cadeia do credito (hero). Unica animacao da pagina: no carregamento a linha
// ciano cresce da compra ate o recolhimento, as etapas 1 e 2 acendem quando a
// linha passa, a 3 acende em ambar (pendencia) e a 4 fica travada.
// Trilho e preenchimento sao pseudo-elementos do <ol> (sem <span> no <ol>).
// Com prefers-reduced-motion o estado final aparece direto.
import { etapas } from "../../content/secoes";
---
<div class="chain">
  <div class="chain-head">
    <p class="chain-lede">A nota está certa. O pagamento saiu. E o crédito ainda não voltou para o caixa.</p>
    <small class="chain-src">Nova lógica de crédito de IBS/CBS, LC 214/2025</small>
  </div>
  <ol class="chain-list" aria-label="Etapas até o crédito de IBS/CBS voltar para o caixa">
    {etapas.map((e) => (
      <li class={`chain-node is-${e.estado}`}>
        <span class="chain-ico" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={e.ico} />
        </span>
        <div class="chain-body">
          <span class="chain-n">Etapa {e.n}</span>
          <strong class="chain-t">{e.titulo}</strong>
          <p>{e.texto}</p>
          <span class="chain-pill"><i aria-hidden="true"></i>{e.status}</span>
        </div>
      </li>
    ))}
  </ol>
</div>
