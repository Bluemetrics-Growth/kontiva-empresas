---
// 09 - CTA + formulario da demo gratuita em duas etapas.
// Etapa 1: Nome, E-mail corporativo (so dominio corporativo), WhatsApp, Cargo.
// Etapa 2: Nome da empresa, Segmento, Faturamento anual, Regime tributario.
// Destino do lead inalterado: sem FORM_ENDPOINT, o envio abre o WhatsApp com
// os dados preenchidos. Se um endpoint (HubSpot) for configurado em
// FORM_ENDPOINT, o POST envia o mesmo payload. Selects com value em slug e o
// label amigavel na interface.
import { WHATSAPP_NUM, WHATSAPP_MSG, DOMINIOS_PESSOAIS, ERRO_EMAIL_PESSOAL } from "../../content/site";

const cargos = [
  { v: "socio_ceo", l: "Sócio(a) ou CEO" },
  { v: "cfo", l: "Diretor(a) financeiro(a) ou CFO" },
  { v: "controller", l: "Controller" },
  { v: "gerente_fiscal", l: "Gerente fiscal ou tributário" },
  { v: "contador_interno", l: "Contador(a) interno(a)" },
  { v: "compras", l: "Compras ou suprimentos" },
  { v: "outro", l: "Outro" },
];
const segmentos = [
  { v: "industria", l: "Indústria" },
  { v: "atacado_distribuicao", l: "Comércio atacadista e distribuição" },
  { v: "varejo", l: "Comércio varejista" },
  { v: "servicos", l: "Serviços" },
  { v: "construcao_incorporacao", l: "Construção e incorporação" },
  { v: "agronegocio", l: "Agronegócio" },
  { v: "logistica_transporte", l: "Logística e transporte" },
  { v: "saude", l: "Saúde" },
  { v: "tecnologia", l: "Tecnologia" },
  { v: "outro", l: "Outro" },
];
const faixas = [
  { v: "ate_20m", l: "Até R$ 20 milhões" },
  { v: "20m_80m", l: "R$ 20 a 80 milhões" },
  { v: "80m_300m", l: "R$ 80 a 300 milhões" },
  { v: "acima_300m", l: "Acima de R$ 300 milhões" },
];
const regimes = [
  { v: "lucro_presumido", l: "Lucro Presumido" },
  { v: "lucro_real", l: "Lucro Real" },
  { v: "simples_nacional", l: "Simples Nacional" },
  { v: "nao_sei", l: "Não sei" },
];
// label de cada value, para a mensagem de WhatsApp ficar legivel
const LABELS = Object.fromEntries(
  Object.entries({ cargo: cargos, segmento: segmentos, faturamento: faixas, regime: regimes })
    .map(([k, list]) => [k, Object.fromEntries(list.map((o) => [o.v, o.l]))])
);
const ERR_SELECT = "Selecione uma opção.";
---
<section class="final grain" id="agendar" aria-labelledby="final-h">
  <div class="shell final-grid">
    <div class="final-copy">
      <div class="eyebrow"><span class="dot-cyan"></span> Demo gratuita</div>
      <h2 id="final-h">Chegue em 2027 decidindo <span class="serif-accent">com número</span>.</h2>
      <p class="final-sub">Não com susto. Demo gratuita com os seus dados: 1 CNPJ, 1 cenário.</p>
      <ol class="setup-steps">
        <li class="setup-step"><span class="sn" aria-hidden="true">1</span><p>Você preenche o formulário em 1 minuto.</p></li>
        <li class="setup-step"><span class="sn" aria-hidden="true">2</span><p>A gente monta o cenário com o seu regime e perfil.</p></li>
        <li class="setup-step"><span class="sn" aria-hidden="true">3</span><p>Na demo, você vê o resultado em reais. Depois decide.</p></li>
      </ol>
      <p class="form-honesty">Agenda de demos limitada à capacidade do nosso time.</p>
    </div>

    <div class="form-card" id="form-card">
      <div class="form-body">
        <h3>Agende sua demo gratuita</h3>
        <p class="fc-sub">Resposta em até 1 dia útil.</p>

        <div class="lf2-progress" aria-hidden="true"><span id="lf2-bar"></span></div>

        <form id="lead-form" novalidate action="" method="post">
          <!-- Etapa 1 -->
          <div class="f-step active" id="step-1" data-step="1">
            <p class="lf2-stepnote">Etapa 1 de 2, seus dados</p>
            <div class="f-field" data-field="nome">
              <label for="lf-nome">Nome</label>
              <input id="lf-nome" name="nome" type="text" placeholder="Seu nome" autocomplete="name" required minlength="2" aria-describedby="err-nome">
              <div class="f-error" id="err-nome">Preencha este campo para continuar.</div>
            </div>
            <div class="f-field" data-field="email">
              <label for="lf-email">E-mail corporativo</label>
              <input id="lf-email" name="email" type="email" placeholder="voce@suaempresa.com.br" autocomplete="email" required aria-describedby="err-email">
              <div class="f-error" id="err-email">E-mail inválido. Confira e tente de novo.</div>
            </div>
            <div class="f-field" data-field="whatsapp">
              <label for="lf-whats">WhatsApp</label>
              <input id="lf-whats" name="whatsapp" type="tel" inputmode="tel" placeholder="(00) 00000-0000" autocomplete="tel" required aria-describedby="err-whats">
              <div class="f-error" id="err-whats">Número incompleto. Inclua o DDD.</div>
            </div>
            <div class="f-field" data-field="cargo">
              <label for="lf-cargo">Cargo</label>
              <select id="lf-cargo" name="cargo" required aria-describedby="err-cargo">
                <option value="">Selecione</option>
                {cargos.map((o) => <option value={o.v}>{o.l}</option>)}
              </select>
              <div class="f-error" id="err-cargo">{ERR_SELECT}</div>
            </div>
            <button type="button" class="btn btn-primary btn-block btn-lg" id="lf-next" data-cta="form-next">Continuar</button>
          </div>

          <!-- Etapa 2 -->
          <div class="f-step" id="step-2" data-step="2">
            <button type="button" class="lf2-back" id="lf-back">Voltar</button>
            <p class="lf2-stepnote">Etapa 2 de 2, usamos isso para montar o seu cenário</p>
            <div class="f-field" data-field="empresa">
              <label for="lf-empresa">Nome da empresa</label>
              <input id="lf-empresa" name="empresa" type="text" placeholder="Nome da empresa" autocomplete="organization" required minlength="2" aria-describedby="err-empresa">
              <div class="f-error" id="err-empresa">Informe o nome da empresa.</div>
            </div>
            <div class="f-field" data-field="segmento">
              <label for="lf-segmento">Segmento</label>
              <select id="lf-segmento" name="segmento" required aria-describedby="err-segmento">
                <option value="">Selecione</option>
                {segmentos.map((o) => <option value={o.v}>{o.l}</option>)}
              </select>
              <div class="f-error" id="err-segmento">{ERR_SELECT}</div>
            </div>
            <div class="f-field" data-field="faturamento">
              <label for="lf-faturamento">Faturamento anual</label>
              <select id="lf-faturamento" name="faturamento" required aria-describedby="err-faturamento">
                <option value="">Selecione</option>
                {faixas.map((o) => <option value={o.v}>{o.l}</option>)}
              </select>
              <div class="f-error" id="err-faturamento">{ERR_SELECT}</div>
            </div>
            <div class="f-field" data-field="regime">
              <label for="lf-regime">Regime tributário</label>
              <select id="lf-regime" name="regime" required aria-describedby="err-regime">
                <option value="">Selecione</option>
                {regimes.map((o) => <option value={o.v}>{o.l}</option>)}
              </select>
              <div class="f-error" id="err-regime">{ERR_SELECT}</div>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-lg" id="lf-submit" data-cta="form">Agendar demo gratuita</button>
          </div>

          <!-- honeypot anti-spam -->
          <div class="f-honeypot" aria-hidden="true">
            <label for="lf-empresa-site">Não preencha este campo</label>
            <input id="lf-empresa-site" name="empresa_site" type="text" tabindex="-1" autocomplete="off">
          </div>

          <p class="f-consent">Ao enviar, você concorda em ser contatado pela Kontiva e autoriza o uso das informações para análise inicial da sua operação. Você pode solicitar exclusão dos dados a qualquer momento.</p>
          <div class="form-sendfail" id="form-sendfail" role="alert">
            Não conseguimos enviar agora. Tente de novo, ou chame a gente no WhatsApp.
            <a href="#" class="btn btn-dark btn-block" id="sendfail-wa" target="_blank" rel="noreferrer" data-cta="whatsapp">Falar no WhatsApp</a>
          </div>
        </form>
      </div>

      <div class="form-success" id="form-success" role="status" aria-live="polite">
        <span class="ok-ico">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>
        </span>
        <h3>Pedido recebido. Agora é com a gente.</h3>
        <p>Em até 1 dia útil entramos em contato para marcar o horário e confirmar o perfil da empresa. A demo cobre 1 CNPJ e 1 cenário.</p>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ WA_NUM: WHATSAPP_NUM, WA_MSG: WHATSAPP_MSG, BLOCKED: DOMINIOS_PESSOAIS, ERR_PESSOAL: ERRO_EMAIL_PESSOAL, LABELS }}>
  (function () {
    var w = window;
    var track = function (n, d) { if (typeof w.__ktrack === "function") w.__ktrack(n, d); else { w.dataLayer = w.dataLayer || []; w.dataLayer.push(Object.assign({ event: n }, d || {})); } };
    var FORM_ENDPOINT = ""; // configurar para POST direto (HubSpot). Vazio: fallback WhatsApp.

    var form = document.getElementById("lead-form");
    if (!form) return;
    var card = document.getElementById("form-card");
    var step1 = document.getElementById("step-1");
    var step2 = document.getElementById("step-2");
    var bar = document.getElementById("lf2-bar");
    var nextBtn = document.getElementById("lf-next");
    var backBtn = document.getElementById("lf-back");
    var submitBtn = document.getElementById("lf-submit");
    var success = document.getElementById("form-success");
    var sendfail = document.getElementById("form-sendfail");
    var sendfailWa = document.getElementById("sendfail-wa");
    var whats = document.getElementById("lf-whats");
    var started = false, step1done = false;

    // UTM e ids de clique (persistidos na sessao)
    var params = new URLSearchParams(location.search), utm = {};
    ["utm_source","utm_medium","utm_campaign","utm_content","utm_term","gclid","fbclid"].forEach(function (k) {
      var v = params.get(k);
      try { v = v || sessionStorage.getItem(k); if (v) sessionStorage.setItem(k, v); } catch (e) {}
      if (v) utm[k] = v;
    });

    // form_view quando o form entra na tela
    if ("IntersectionObserver" in w) {
      var io = new IntersectionObserver(function (e) { if (e[0].isIntersecting) { track("form_view"); io.disconnect(); } }, { threshold: 0.3 });
      io.observe(form);
    }

    // Mascara de WhatsApp (nao bloqueia colar: normaliza no fim)
    whats.addEventListener("input", function () {
      var d = whats.value.replace(/\D/g, "").slice(0, 11), out = d;
      if (d.length > 2) out = "(" + d.slice(0, 2) + ") " + d.slice(2);
      if (d.length > 7) out = "(" + d.slice(0, 2) + ") " + d.slice(2, 7) + "-" + d.slice(7);
      whats.value = out;
    });

    form.addEventListener("focusin", function () { if (!started) { started = true; track("form_start"); } });

    // Regras por campo. Validacao no blur (depois do primeiro toque) e ao avancar.
    var emailErr = document.getElementById("err-email");
    var ERR_EMAIL_FORMATO = emailErr.textContent;
    var dominio = function (v) { return v.trim().toLowerCase().split("@").pop(); };
    var emailPessoal = function (v) { return BLOCKED.indexOf(dominio(v)) !== -1; }; // so o dominio exato
    var filled = function (v) { return v !== ""; };
    var rules = {
      nome: function (v) { return v.trim().length >= 2; },
      email: function (v) {
        var formato = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim());
        emailErr.textContent = formato ? ERR_PESSOAL : ERR_EMAIL_FORMATO;
        return formato && !emailPessoal(v);
      },
      whatsapp: function (v) { return v.replace(/\D/g, "").length >= 10; },
      cargo: filled,
      empresa: function (v) { return v.trim().length >= 2; },
      segmento: filled,
      faturamento: filled,
      regime: filled
    };
    var STEP1 = ["nome", "email", "whatsapp", "cargo"];
    var STEP2 = ["empresa", "segmento", "faturamento", "regime"];
    var check = function (name) {
      var input = form.elements[name];
      var ok = rules[name](input.value);
      var wrap = form.querySelector('[data-field="' + name + '"]');
      if (wrap) wrap.classList.toggle("invalid", !ok);
      input.setAttribute("aria-invalid", ok ? "false" : "true");
      return ok;
    };
    var checkAll = function (names) {
      var firstBad = null;
      names.forEach(function (n) { if (!check(n) && !firstBad) firstBad = form.elements[n]; });
      if (firstBad) firstBad.focus();
      return !firstBad;
    };
    STEP1.concat(STEP2).forEach(function (n) {
      var input = form.elements[n];
      input.addEventListener("blur", function () { if (input.value !== "" || input.getAttribute("aria-invalid")) check(n); });
      input.addEventListener(input.tagName === "SELECT" ? "change" : "input", function () { if (input.getAttribute("aria-invalid") === "true") check(n); });
    });

    var goStep = function (n) {
      step1.classList.toggle("active", n === 1);
      step2.classList.toggle("active", n === 2);
      bar.style.width = n === 2 ? "100%" : "50%";
      var first = (n === 1 ? step1 : step2).querySelector("input, select");
      if (first) first.focus();
    };
    nextBtn.addEventListener("click", function () {
      if (!checkAll(STEP1)) return;
      if (!step1done) { step1done = true; track("form_step_1_complete"); }
      goStep(2);
    });
    backBtn.addEventListener("click", function () { goStep(1); }); // preserva dados

    var label = function (campo, v) { return (LABELS[campo] && LABELS[campo][v]) || v || "não informado"; };
    var waWithData = function (d) {
      var msg = WA_MSG +
        "%0A%0ANome: " + (d.nome || "") + "%0AE-mail: " + (d.email || "") + "%0AWhatsApp: " + (d.whatsapp || "") +
        "%0ACargo: " + label("cargo", d.cargo) + "%0AEmpresa: " + (d.empresa || "") +
        "%0ASegmento: " + label("segmento", d.segmento) + "%0AFaturamento: " + label("faturamento", d.faturamento) +
        "%0ARegime: " + label("regime", d.regime);
      return "https://wa.me/" + WA_NUM + "?text=" + msg;
    };
    var showSuccess = function (d) {
      card.classList.add("sent"); success.classList.add("show"); success.scrollIntoView({ behavior: "smooth", block: "center" });
      track("form_submit_success", d ? { cargo: d.cargo, segmento: d.segmento, faturamento: d.faturamento } : undefined);
    };

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      sendfail.classList.remove("show");
      if (form.empresa_site.value) { showSuccess(); return; } // honeypot
      if (!STEP1.every(function (n) { return rules[n](form.elements[n].value); })) { goStep(1); checkAll(STEP1); return; }
      if (!checkAll(STEP2)) return;
      // revalida tudo na funcao de envio (inclui o bloqueio de e-mail pessoal)
      if (emailPessoal(form.email.value)) { goStep(1); checkAll(STEP1); return; }
      var data = {
        nome: form.nome.value.trim(), email: form.email.value.trim(), whatsapp: whats.value.trim(), cargo: form.cargo.value,
        empresa: form.empresa.value.trim(), segmento: form.segmento.value, faturamento: form.faturamento.value, regime: form.regime.value,
        page_url: location.href
      };
      Object.assign(data, utm);
      submitBtn.classList.add("is-loading");
      submitBtn.innerHTML = '<span class="spinner"></span> Enviando...';
      var finishFail = function () {
        submitBtn.classList.remove("is-loading"); submitBtn.textContent = "Agendar demo gratuita";
        sendfailWa.href = waWithData(data); sendfail.classList.add("show"); track("form_submit_error");
      };
      if (FORM_ENDPOINT) {
        fetch(FORM_ENDPOINT, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) })
          .then(function (r) { if (!r.ok) throw new Error("bad status"); showSuccess(data); })
          .catch(finishFail);
      } else {
        try { w.open(waWithData(data), "_blank", "noopener"); showSuccess(data); } catch (err) { finishFail(); }
      }
    });
    sendfailWa.href = "https://wa.me/" + WA_NUM + "?text=" + encodeURIComponent(WA_MSG);
  })();
</script>
