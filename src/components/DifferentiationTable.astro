---
// S4 A regua de diferenciacao. "ERP simula, agente opera." Degrau 4 e a bandeira.
const rows = [
  { n: '1', step: 'Tirar dúvida da reforma (chatbot)', who: 'Todos, de graça', pos: 'Não competimos aqui. Útil e genérico.', flag: false },
  { n: '2', step: 'Simular um cenário por vez', who: 'ERPs e consultorias', pos: 'Não abrimos conversa por aqui.', flag: false },
  { n: '3', step: 'Simular a operação inteira em massa (todos os CNPJs e cenários), ranquear, multi-sistema', who: 'Só o Kontiva', pos: 'Toda a sua operação de uma vez, em qualquer sistema.', flag: false },
  { n: '4', step: 'Operar a rotina: créditos, adimplência de fornecedor, caixa do split e repricing, contínuo, com observabilidade e aprovação', who: 'Vazio. Nossa bandeira.', pos: 'A pergunta que ninguém responde: quem vai rodar isso todo mês na sua empresa?', flag: true },
];
---
<section class="bg-dark grain" aria-labelledby="dif-h">
  <div class="shell">
    <div class="section-head reveal">
      <div class="eyebrow"><span class="dot-cyan"></span> A régua</div>
      <h2 id="dif-h">Onde a maioria para, o Kontiva começa.</h2>
      <p class="lead">Tirar dúvida e simular um cenário por vez já é grátis nos ERPs e nas calculadoras. Ótimo, use. O nosso degrau é outro.</p>
    </div>

    <div class="ladder reveal delay-1">
      <div class="ladder-row head">
        <div>Degrau</div><div>Quem está lá</div><div>Como o Kontiva se posiciona</div>
      </div>
      {rows.map((r) => (
        <div class={`ladder-row ${r.flag ? 'flagged' : ''}`}>
          <div class="ladder-step"><span class="n">{r.n}</span>{r.step}</div>
          <div class="ladder-who">{r.who}</div>
          <div class="ladder-pos">
            {r.flag && <span class="ladder-flag">Nossa bandeira</span>}
            {r.pos}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
