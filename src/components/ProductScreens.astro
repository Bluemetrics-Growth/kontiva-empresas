---
// 05 - Plataforma: telas do sistema, com dados de demonstracao. Tres molduras do
// mesmo tamanho (16/10, recorte no canto superior esquerdo); cada imagem abre
// a captura inteira. Em telas estreitas a fileira rola com scroll-snap.
import { telas } from "../../content/secoes";
---
<section class="bg-alt" id="plataforma" aria-labelledby="telas-h">
  <div class="shell">
    <div class="section-head">
      <div class="eyebrow"><span class="dot-cyan"></span> Plataforma</div>
      <h2 id="telas-h">Veja onde o agente <span class="serif-accent">trabalha</span>.</h2>
      <p class="lead">Estas são as telas que o seu time usa, aqui com dados de demonstração. Na demo, o agente roda o mesmo fluxo com o perfil da sua empresa.</p>
    </div>

    <div class="scr-row">
      {telas.map((t) => (
        <figure class="scr">
          <div class="scr-frame">
            <div class="scr-bar" aria-hidden="true">
              <span class="scr-dots"><i></i><i></i><i></i></span>
              <span class="scr-url">{t.url}</span>
            </div>
            <a href={`/images/telas/${t.id}.webp`} target="_blank" rel="noopener" class="scr-img" aria-label={`Abrir a tela ${t.titulo} em tamanho real`}>
              <picture>
                <source srcset={`/images/telas/${t.id}.webp`} type="image/webp" />
                <img src={`/images/telas/${t.id}.jpg`} width={t.w} height={t.h} alt={t.alt} loading="lazy" decoding="async" />
              </picture>
            </a>
          </div>
          <figcaption><b>{t.titulo}.</b> {t.legenda}</figcaption>
        </figure>
      ))}
    </div>
    <small class="scr-note">Dados de demonstração. Nomes de fornecedores ocultados.</small>
  </div>
</section>
