---
// 09 - Seguranca e IA auditavel (PRD revisao, secao 5.8). Quatro pilares.
const pillars = [
  { t: "Fonte visível", d: "Toda resposta mostra de onde veio o número.", ico: '<path d="M4 5a2 2 0 0 1 2-2h10v18H6a2 2 0 0 1-2-2z"/><path d="M16 3l4 2v16l-4-2"/>' },
  { t: "Memória de cálculo", d: "Seu time entende como a simulação foi formada.", ico: '<path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/>' },
  { t: "Aprovação humana", d: "Nada é aplicado sem revisão.", ico: '<path d="M20 6L9 17l-5-5"/>' },
  { t: "Segurança dos dados", d: "Acesso com controles, consentimento e rastreabilidade.", ico: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>' },
];
---
<section class="bg-dark grain" id="confianca" aria-labelledby="trust-h">
  <div class="shell">
    <div class="section-head reveal">
      <div class="eyebrow"><span class="dot-cyan"></span> Segurança e IA auditável</div>
      <h2 id="trust-h" style="color:var(--branco);">IA para operação crítica precisa ser auditável.</h2>
    </div>
    <div class="trust-grid">
      {pillars.map((p, i) => (
        <article class={`trust-pillar reveal delay-${i % 3}`}>
          <span class="tp-ico" aria-hidden="true">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={p.ico} />
          </span>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </article>
      ))}
    </div>
    <p class="trust-note reveal">Quando houver uso de certificado digital, o acesso é feito com finalidade restrita à leitura dos dados necessários para a simulação e operação fiscal. A Kontiva lê, cruza, simula, monitora e alerta. A decisão continua com a sua empresa.</p>
  </div>
</section>
