---
// 07 - Confianca (PRD v3 secao 10). Quatro pilares, navy curto.
const pillars = [
  { t: "Fonte visível", d: "Toda resposta mostra a origem.", ico: '<path d="M4 5a2 2 0 0 1 2-2h10v18H6a2 2 0 0 1-2-2z"/><path d="M16 3l4 2v16l-4-2"/>' },
  { t: "Memória de cálculo", d: "O time entende como o número foi formado.", ico: '<path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/>' },
  { t: "Aprovação humana", d: "Nada é executado sem revisão.", ico: '<path d="M20 6L9 17l-5-5"/>' },
  { t: "BlueMetrics", d: "10+ anos de IA aplicada e 200+ projetos.", ico: '<circle cx="12" cy="12" r="9"/><path d="M12 7v10M7 12h10"/>' },
];
---
<section class="bg-dark grain" id="confianca" aria-labelledby="trust-h">
  <div class="shell">
    <div class="section-head reveal">
      <div class="eyebrow"><span class="dot-cyan"></span> Segurança e observabilidade</div>
      <h2 id="trust-h" style="color:var(--branco);">IA para operação crítica precisa ser auditável.</h2>
    </div>
    <div class="trust-grid">
      {pillars.map((p, i) => (
        <article class={`trust-pillar reveal delay-${i % 3}`}>
          <span class="tp-ico" aria-hidden="true">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={p.ico} />
          </span>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>
